{
  "name": "@platform/flex",
  "type": "module",
  "scripts": {
    "dev": "cdk watch",
    "hotswap": "cdk deploy --hotswap",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --concurrency 4 --require-approval never",
    "destroy": "cdk destroy --all",
    "synth": "cdk synth",
    "drift:check": "cdk synth --quiet && tsx src/scripts/drift-check.ts",
    "validate:integrations": "tsx src/scripts/validate-integrations.ts",
    "validate:macie-coverage": "tsx src/scripts/check-macie-coverage.ts",
    "tsc": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest --passWithNoTests",
    "checkov": "cdk synth --quiet && checkov --config-file checkov.yaml -d cdk.out --framework cloudformation --compact --quiet"
  },
  "dependencies": {
    "@flex/sdk": "workspace:*",
    "@flex/service-gateway": "workspace:*",
    "@platform/credential-monitor": "workspace:*",
    "@platform/smoke-test": "workspace:*",
    "aws-cdk": "2.1149.0",
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "graphology": "0.26.0",
    "graphology-dag": "0.4.1",
    "jiti": "2.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1172.0",
    "@aws-sdk/credential-providers": "3.1172.0",
    "@flex/config": "workspace:*",
    "@flex/utils": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
