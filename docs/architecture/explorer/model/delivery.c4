        role 'The same job once more.'
        facts [
          'Platform E2E is skipped in production, and no Module E2E runs against it.',
          'Production correctness therefore rests on staging plus the always-on canary, whose alarm currently notifies nobody.'
        ]
        sourceId 'deployprod'
        order '26'
        x '1003'
        y '673'
        w '177'
        h '66'
        ownership 'flex'
      }
