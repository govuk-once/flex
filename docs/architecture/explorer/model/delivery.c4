views {
  view delivery {
    title 'Delivery'
    include delivery_zauthor, delivery_zauthor.**
    include delivery_zlocal, delivery_zlocal.**
    include delivery_zpromote, delivery_zpromote.**
    include delivery_zoperate, delivery_zoperate.**
  }
}
