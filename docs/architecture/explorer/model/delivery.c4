    delivery_zap = platform 'ZAP API scan' {
      #off-request-path
      description 'DAST against staging'
      technology 'zap.yml'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/zap.yml 'zap.yml'
      link https://github.com/govuk-once/flex/blob/main/scripts/dastSetup.ts 'dastSetup.ts'
      link https://github.com/govuk-once/flex/blob/main/docs/zap.md 'zap.md'
      metadata {
        type 'Workflow'
        tech 'zap.yml'
        role 'Dynamic security scan driven by an OpenAPI document.'
        facts [
          'Triggered by workflow_run when the whole Continuous Deployment workflow completes successfully on main — including the production gate. If production is rejected, DAST never runs.',
          'Mints a real JWT first; the scan emits a SARIF report kept as a workflow-run artifact — nothing uploads it to code scanning.',
          'The target is .zap/merged-openapi.json, a spec committed with the workflow and unchanged since: paths such as /v1/driving-licence and /v1/customer-summary no longer exist, and .zap/rules.tsv is empty.'
        ]
        sourceId 'zap'
        order '28'
        x '1243'
        y '775'
        w '177'
        h '66'
        ownership 'flex'
      }
    }

    delivery_artillery = platform 'Artillery load tests' {
      #off-request-path
      description 'workflow_dispatch only'
      technology 'Artillery 2 · CloudWatch plugin'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/performance-tests.yml 'performance-tests.yml'
      link https://github.com/govuk-once/flex/blob/main/tests/performance/README.md 'README.md'
      link https://github.com/govuk-once/flex/blob/main/tests/performance/package.json 'package.json'
      metadata {
        type 'Test suite'
        tech 'Artillery 2 · CloudWatch plugin'
        role 'Load profiles against a deployed stage.'
        facts [
          'Six profiles live in tests/performance — smoke, load-baseline, load-growth, spike, stress (ramping to 2000 virtual users) and soak — but the workflow runs only the three default scenarios, one job each.',
          'Thresholds are declared per scenario (p95 3000ms for the upsert, 1500ms for the two reads, error rate under 1%) and the run step is continue-on-error, so a breach never fails the workflow.',
          'On staging every virtual user shares one real Cognito token, so those numbers measure endpoint throughput, not per-user concurrency.',
          'The user-settings scenario PATCHes /app/udp/v1/users/notifications, but the udp route is /v1/users/me/notifications — it cannot return the 200 it asserts.'
        ]
        sourceId 'artillery'
        order '29'
        x '1243'
        y '877'
        w '180'
        h '66'
        ownership 'flex'
      }
    }
  }

  delivery_zoperate = boundary 'Operate · continuously' {
    metadata {
      type 'Lifecycle phase'
      tech 'CloudWatch · SNS · AWS Chatbot'
      role 'How a running stage reports on itself.'
      facts [
        'Absorbed from the Containers view: these four AWS containers are operations, not part of the runtime request path.'
      ]
      sourceId 'zoperate'
      order '3'
      x '1482'
      y '65'
      w '456'
      h '933'
      boundary 'soft'
