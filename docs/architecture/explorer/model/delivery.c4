        tech 'Amazon SNS, KMS encrypted'
        role 'flex-alerts-critical and flex-alerts-warning, plus the release topic.'
        facts [
          'Created by the core stack, so they exist only in persistent stages; ephemeral and personal stages import the development ones.',
          'flex-release-notifications exists only in development, which is why the staging and production notify jobs assume the development role to publish.'
        ]
        sourceId 'topics'
        order '34'
        x '1496'
        y '390'
        w '220'
        h '70'
        ownership 'flex'
        awsIcon 'sns'
        resources [
          'sns-alarms',
          'sns-release',
