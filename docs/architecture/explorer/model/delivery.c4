// FLEX architecture — Delivery.
//
// The model. Presentation that a LikeC4 view cannot hold — tab order, audience,
// reference tables — is in views.json beside this file.

model {

  delivery_zauthor = boundary 'Author and review · every pull request' {
    metadata {
      type 'Lifecycle phase'
      tech 'GitHub Actions'
      role 'Everything that runs before a change can merge.'
      facts [
        'Four workflows fire on a pull request to main: Release Candidate (quality checks plus an ephemeral deploy), Validate OpenAPI Spec, Validate PR Title and, on close, Destroy Ephemeral Environment.'
      ]
      sourceId 'zauthor'
      order '0'
      x '23'
      y '65'
      w '707'
      h '696'
      boundary 'soft'
    }

    delivery_domteam = actor 'Domain team' {
      #off-request-path
      description 'person'
      link https://github.com/govuk-once/flex/blob/main/.github/CODEOWNERS 'CODEOWNERS'
      link https://github.com/govuk-once/flex/blob/main/docs/domain-development.md 'domain-development.md'
      metadata {
        type 'Person'
        tech '—'
        role 'Builds and deploys a domain. Writes no infrastructure.'
        facts [
          'This is the intended operating model: a domain team is meant to own only domains/{name}/*. CODEOWNERS still assigns every path to the FLEX platform developers team pending domain-team onboarding.',
          'Deploys by merging: the shared pipeline creates the Lambdas, API resources, IAM policies and alarms from the declared config.',
          'Adding a domain needs no platform change; only a new third-party integration does.',
          'dvla, example, groups and uns each take a workspace dependency on <code>@flex/udp-domain</code>; three of them import a udp Zod schema into their own domain.config.ts, so a udp schema change is a compile-time break.'
        ]
        sourceId 'domteam'
        order '0'
        x '46'
        y '116'
        w '177'
        h '58'
        ownership 'person'
      }
    }

    delivery_platteam = actor 'FLEX platform team' {
      #off-request-path
      description 'person'
      link https://github.com/govuk-once/flex/blob/main/docs/platform-development.md 'platform-development.md'
      metadata {
        type 'Person'
        tech '—'
        role 'Owns every piece of infrastructure a domain runs on.'
        facts [
          'Owns libs/*, platform/* and the CDK app — and, until domain teams onboard, every path in CODEOWNERS as well.',
          'Owns the two shared API Gateways, the VPC, the service gateways and the pipeline itself.',
          'A domain team never writes CDK; the platform team never writes domain logic.'
        ]
        sourceId 'platteam'
        order '1'
        x '46'
        y '206'
        w '177'
        h '58'
        ownership 'person'
      }
    }

    delivery_repo = external 'GitHub · govuk-once/flex' {
      #off-request-path
      description 'source of truth'
      technology 'GitHub'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/main.yml 'main.yml'
      metadata {
        type 'External system'
        tech 'GitHub'
        role 'Hosts the code, the pipeline and the releases.'
        facts [
          'Everything reaches production through one workflow: Continuous Deployment, on push to main.',
          'Deployment credentials are never stored — CI federates into AWS with OIDC and a per-environment role.'
        ]
        sourceId 'repo'
        order '2'
        x '290'
        y '153'
        w '200'
        h '58'
        ownership 'third'
      }
    }

    delivery_title = platform 'PR title gate' {
      #off-request-path
      description 'required check · own workflow'
      technology 'ci-pr-title-check.yml'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/ci-pr-title-check.yml 'ci-pr-title-check.yml'
      link https://github.com/govuk-once/flex/blob/main/.releaserc.json '.releaserc.json'
      metadata {
        type 'Workflow'
        tech 'ci-pr-title-check.yml'
        role 'Enforces the commit header that semantic-release later parses.'
        facts [
          'Fails unless the title matches {JIRA-KEY} {type}(scope)?!?: description, with type one of feat, fix, chore, docs, style, refactor, test, perf, ci, build or revert.',
          'The squash-merge commit is this title, and the release parser tolerates a leading Jira key — the gate is what makes that tolerance safe rather than accidental.',
          'Dependabot pull requests are skipped; a single bot comment is created or updated with the guidance.'
        ]
        sourceId 'title'
        order '3'
        x '290'
        y '262'
        w '227'
        h '58'
        ownership 'flex'
      }
    }

    delivery_ghpr = external 'on pull_request → main' {
      #off-request-path
      description 'three workflows run in parallel'
      technology 'GitHub Actions'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/ci-pr-quality-checks.yml 'ci-pr-quality-checks.yml'
      metadata {
        type 'Trigger'
        tech 'GitHub Actions'
        role 'The pull-request event that starts the checks below.'
        facts [
          'Release Candidate runs Quality Checks and the ephemeral deploy in parallel, then Module E2E against the stage it created.',
          'Concurrency is grouped per head ref: the OpenAPI and title workflows cancel in-progress runs, Release Candidate deliberately does not.'
        ]
        sourceId 'ghpr'
        order '4'
        x '46'
        y '371'
        w '240'
        h '32'
        ownership 'third'
      }
    }

    delivery_qc = platform 'Quality Checks' {
      #off-request-path
      description '3 parallel jobs'
      technology '_quality-checks.yml'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/_quality-checks.yml '_quality-checks.yml'
      metadata {
        type 'Workflow'
        tech '_quality-checks.yml'
        role 'Hygiene, SonarQube and Security, on pull requests and on main alike.'
        facts [
          'Hygiene: pre-commit over all files, then lint, tsc, validate:integrations and validate:macie-coverage. An uncovered domain does not fail the job — it posts a Slack notice, and both that step and its credential step are <code>continue-on-error</code>.',
          'Security: checkov over synthesised CloudFormation, plus dependency review failing at high severity.',
          'Nx runs lint, tsc and checkov against affected projects, on PR and main runs alike; unit tests always run for every project (run-many --all) inside the SonarQube job.',
          'Only the CDK app declares a checkov target, so that scan runs only when platform/infra is affected.'
        ]
        sourceId 'qc'
        order '5'
        x '46'
        y '443'
        w '177'
        h '62'
        ownership 'flex'
      }
    }

    delivery_oas = platform 'OpenAPI breaking check' {
      #off-request-path
      description 'per PR'
      technology '_validate-openapi.yml'
      link https://github.com/govuk-once/flex/blob/main/scripts/checkOpenapiBreaking.ts 'checkOpenapiBreaking.ts'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/_validate-openapi.yml '_validate-openapi.yml'
      metadata {
        type 'Workflow'
        tech '_validate-openapi.yml'
        role 'Regenerates every domain\'s spec and diffs it against what is published.'
        facts [
          'oasdiff compares against the specs in the development spec bucket — not staging, not production.',
          'Only ERR-level findings fail; a spec that disappears counts as breaking too.',
          'The breaking-change-accepted label overrides the failure.'
        ]
        sourceId 'oas'
        order '6'
        x '267'
        y '443'
        w '186'
        h '62'
        ownership 'flex'
      }
    }

    delivery_eph = platform 'Ephemeral stage' {
      #off-request-path
      description 'pr-{number} · full deploy'
      technology 'cdk deploy --all'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/ci-pr-quality-checks.yml 'ci-pr-quality-checks.yml'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/utils/deployment.ts 'deployment.ts'
      metadata {
        type 'Environment'
        tech 'cdk deploy --all'
        role 'A complete, isolated copy of the platform for one pull request.'
        facts [
          'Reuses the development VPC, endpoints, security groups and alarm topics — it creates no core stack, and no canary.',
          'Environment gating is only enforced for persistent stages, so every domain deploys here, example included.',
          'It runs the same reusable job as the three environments, Platform E2E included, and gets its own subdomain and its own WAF bypass secret.'
        ]
        sourceId 'eph'
        order '7'
        x '488'
        y '443'
        w '200'
        h '62'
        ownership 'flex'
      }
    }

    delivery_sonar = external 'SonarQube' {
      #off-request-path
      description 'quality gate'
      technology 'sonarqube-scan-action'
      link https://github.com/govuk-once/flex/blob/main/sonar-project.properties 'sonar-project.properties'
      metadata {
        type 'External system'
        tech 'sonarqube-scan-action'
        role 'Static analysis across the whole workspace; coverage across the domains, libs and service gateways only — the CDK app, CLI, testing lib, smoke-test, domain.config.ts/gateway.config.ts files, example and local-council are all excluded from coverage.'
        facts [
          'sonar.qualitygate.wait=true, so a failing gate fails the job.',
          'It also consumes an ESLint JSON report, generated with || true so a lint crash cannot fail the scan.'
        ]
        sourceId 'sonar'
        order '8'
        x '46'
        y '552'
        w '177'
        h '62'
        ownership 'third'
      }
    }

    delivery_me2e = platform 'Module E2E' {
      #off-request-path
      description 'matrix per domain'
      technology '_moduleE2E.yml'
      link https://github.com/govuk-once/flex/blob/main/scripts/listE2eModules.ts 'listE2eModules.ts'
      link https://github.com/govuk-once/flex/blob/main/libs/testing/src/e2e/setup.global.ts 'setup.global.ts'
      metadata {
        type 'Workflow'
        tech '_moduleE2E.yml'
        role 'Runs each domain\'s own E2E suite against the ephemeral stage.'
        facts [
          'Domains are discovered at runtime by scanning for a test:e2e script — five of six qualify; local-council declares none, so it is never covered.',
          'fail-fast is off, so one domain failing does not mask the others.',
          'Suites read their URLs from the FlexPlatform and FlexGlobal stack outputs rather than hard-coding them.'
        ]
        sourceId 'me2e'
        order '9'
        x '488'
        y '552'
        w '177'
        h '62'
        ownership 'flex'
      }
    }

    delivery_cleanup = platform 'Destroy on PR close' {
      #off-request-path
      description 'cdk destroy --all --force'
      technology 'ci-pr-cleanup.yml'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/ci-pr-cleanup.yml 'ci-pr-cleanup.yml'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/constructs/s3/AccessLogBucket.ts 'AccessLogBucket.ts'
      metadata {
        type 'Workflow'
        tech 'ci-pr-cleanup.yml'
        role 'Tears the ephemeral stage down when the pull request closes.'
        facts [
          'The ephemeral OpenAPI specs bucket is created with autoDeleteObjects so the destroy completes; the two access-log buckets it depends on are object-locked (365-day GOVERNANCE) and retained.'
        ]
        sourceId 'cleanup'
        order '10'
        x '46'
        y '661'
        w '200'
        h '62'
        ownership 'flex'
      }
    }
  }

  delivery_zlocal = boundary 'Outside the pipeline · workspace, CLI and personal stages' {
    metadata {
      type 'Lifecycle phase'
      tech 'pnpm workspace · local tooling'
      role 'What an engineer touches before a pull request exists.'
      sourceId 'zlocal'
      order '1'
      x '23'
      y '800'
      w '707'
      h '197'
      boundary 'soft'
    }

    delivery_cli = platform 'flex CLI' {
      #off-request-path
      description 'Ink TUI · pnpm dev'
      technology 'Ink + React + Mustache'
      link https://github.com/govuk-once/flex/blob/main/libs/cli/src/templates/createDomain.ts 'createDomain.ts'
      link https://github.com/govuk-once/flex/blob/main/libs/cli/src/panels/CreateDomainPanel.tsx 'CreateDomainPanel.tsx'
      metadata {
        type 'Developer tool'
        tech 'Ink + React + Mustache'
        role 'Scaffolds a whole domain from templates.'
        facts [
          'Eight Mustache templates produce package.json, domain.config.ts, tsconfig, vitest and eslint config, a README and one v1/hello handler.',
          'It then runs pnpm up --latest, pnpm install, tsc and lint inside the new package, so a scaffolded domain compiles before anything is written by hand.',
          'This is the on-ramp that makes "adding a domain needs no platform change" true.'
        ]
        sourceId 'cli'
        order '11'
        x '46'
        y '854'
        w '177'
        h '72'
        ownership 'flex'
      }
    }

    delivery_personal = platform 'Personal · {USER}' {
      #off-request-path
      description 'no pipeline or cleanup'
      technology 'cdk deploy --all'
      link https://github.com/govuk-once/flex/blob/main/libs/utils/src/environments.ts 'environments.ts'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/app.ts 'app.ts'
      metadata {
        type 'Environment'
        tech 'cdk deploy --all'
        role 'A full named stage an engineer deploys from a laptop.'
        facts [
          'getEnvConfig() falls back to process.env.USER, so a deploy with no STAGE set creates a stage named after the engineer — lowercased, stripped to a-z0-9- and truncated to 12 characters.',
          'It behaves exactly like a PR stage: development account, development VPC, endpoints and topics, every domain including example.',
          'Nothing tears it down — only pr-{number} stages have a cleanup workflow.'
        ]
        sourceId 'personal'
        order '12'
        x '267'
        y '854'
        w '182'
        h '72'
        ownership 'flex'
      }
    }

    delivery_supply = platform 'Supply-chain controls' {
      #off-request-path
      description 'workspace + pre-commit'
      technology 'pnpm · pre-commit · Dependabot'
      link https://github.com/govuk-once/flex/blob/main/pnpm-workspace.yaml 'pnpm-workspace.yaml'
      link https://github.com/govuk-once/flex/blob/main/.pre-commit-config.yaml '.pre-commit-config.yaml'
      link https://github.com/govuk-once/flex/blob/main/.github/dependabot.yml 'dependabot.yml'
      metadata {
        type 'Policy'
        tech 'pnpm · pre-commit · Dependabot'
        role 'What is allowed into the dependency tree and the working tree.'
        facts [
          'pnpm minimumReleaseAge: 10080 quarantines any newly published version for seven days.',
          'An overrides block pins six transitive dependencies out of vulnerable ranges; allowBuilds denies install scripts by default, permitting only esbuild and the Playwright Chromium browser.',
          'pre-commit runs Yelp detect-secrets against a 129KB checked-in baseline, plus detect-private-key and the file hygiene hooks — CI runs the same hooks with --all-files.',
          'Dependabot batches patch and minor updates weekly for npm and GitHub Actions, with a 7-day cooldown.'
        ]
        sourceId 'supply'
        order '13'
        x '488'
        y '854'
        w '180'
        h '72'
        ownership 'flex'
      }
    }
  }

  delivery_zpromote = boundary 'Promote · every merge to main' {
    metadata {
      type 'Lifecycle phase'
      tech 'Continuous Deployment workflow'
      role 'One workflow run carries a commit from release to production.'
      facts [
        'The spine down the middle is the only thing that blocks production; everything on the right rail runs beside it and gates nothing.'
      ]
      sourceId 'zpromote'
      order '2'
      x '752'
      y '65'
      w '707'
      h '933'
      boundary 'soft'
    }

    delivery_release = platform 'semantic-release' {
      #off-request-path
      description 'tag + GitHub release'
      technology 'semantic-release on main'
      link https://github.com/govuk-once/flex/blob/main/.releaserc.json '.releaserc.json'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/main.yml 'main.yml'
      metadata {
        type 'Workflow job'
        tech 'semantic-release on main'
        role 'Decides the version and publishes the release notes.'
        facts [
          'The commit parser tolerates a leading Jira key, so FLEX-250 chore: … still classifies correctly.',
          'Tags are v{version}; when nothing is released the run falls back to the latest tag, then to the short SHA, so a deployment notice always names something.',
          'Only major and minor releases publish a Slack notice, and that step is continue-on-error.'
        ]
        sourceId 'release'
        order '14'
        x '1003'
        y '116'
        w '177'
        h '54'
        ownership 'flex'
      }
    }

    delivery_oidc = platform 'AWS deployment roles' {
      #off-request-path
      description 'OIDC federation'
      technology 'aws-actions/configure-aws-credentials'
      link https://github.com/govuk-once/flex/blob/main/docs/zap.md 'zap.md'
      metadata {
        type 'IAM'
        tech 'aws-actions/configure-aws-credentials'
        role 'How CI gets into the accounts.'
        facts [
          'A separate role secret per environment — DEV, STAGING and PROD; the ZAP scan and a staging performance run assume the staging one too.',
          'Short-lived credentials only; nothing long-lived is stored in GitHub.',
          'The session name is the workflow run ID, so CloudTrail ties every action back to a run.',
          'The staging role\'s trust policy only allows main, which is why the ZAP runbook says to swap in the dev role when testing from a branch.'
        ]
        sourceId 'oidc'
        order '15'
        x '775'
        y '227'
        w '177'
        h '62'
        ownership 'flex'
        awsIcon 'iam'
      }
    }

    delivery_params = internal 'flex-params + DNS' {
      #off-request-path
      description 'SSM · owned elsewhere'
      technology 'SSM Parameter Store · Route 53'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/ssm-keys.ts 'ssm-keys.ts'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/utils/lambda.ts 'lambda.ts'
      metadata {
        type 'GOV.UK Once configuration source'
        tech 'SSM Parameter Store · Route 53'
        role 'Supplies the hosted zone, auth identifiers and consumer secrets.'
        facts [
          'Declared through addExternalExports: importing a key no stack exports and that isn\'t declared external fails the synth. The values themselves are CloudFormation SSM references resolved at deploy time, so a parameter missing from SSM fails the deploy.',
          'The only genuine synth-time read is ReleaseSlackChannelId, via valueFromLookup.',
          'One import escapes the rule: the Lambda environment-encryption CMK is read with valueForStringParameter without being declared external, so a missing key there surfaces at deploy rather than synth.'
        ]
        sourceId 'params'
        order '16'
        x '775'
        y '332'
        w '177'
        h '62'
        ownership 'govuk'
        awsIcon 'ssm'
        resources [
          'ssm-imported'
        ]
      }
    }

    delivery_ssmapp = platform 'SsmApp stack graph' {
      #off-request-path
      description 'synth-time DAG'
      technology 'graphology DirectedGraph'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/base/index.ts 'base/index.ts'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/app.ts 'app.ts'
      metadata {
        type 'CDK App'
        tech 'graphology DirectedGraph'
        role 'Turns SSM imports and exports into stack dependencies.'
        facts [
          'Every import() records an edge and willCreateCycle rejects a cycle at synth; synth() then converts each edge into an addDependency call.',
          'That ordering is what makes cdk deploy --all --concurrency 4 safe.',
          'Stacks per stage: FlexCore and FlexSmokeTest (persistent stages only), FlexPlatform, FlexGlobal in us-east-1, one stack per deployable domain, and FlexApiDeployment last. FlexMacie is commented out in app.ts.'
        ]
        sourceId 'ssmapp'
        order '17'
        x '775'
        y '450'
        w '177'
        h '62'
        ownership 'flex'
        resources [
          'ssm-written',
          'ssm-crossregion'
        ]
      }
    }

    delivery_apideploy = platform 'API stage redeploy' {
      #off-request-path
      description 'AwsCustomResource ×2'
      technology 'apigateway:createDeployment'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/deploy.ts 'stacks/deploy.ts'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/constructs/infra/CfnPause.ts 'CfnPause.ts'
      metadata {
        type 'Custom resource'
        tech 'apigateway:createDeployment'
        role 'Forces a new deployment of both REST APIs once the domain stacks have added their routes.'
        facts [
          'It declares every deployed domain stack as a dependency, which is how the graph places it last.',
          'The sorted METHOD:path list is SHA-256 hashed into the deployment description, so a redeploy only happens when the route set actually changes.',
          'A CfnPause custom resource sleeps six seconds between the public and the private call, because createDeployment is rate-limited.'
        ]
        sourceId 'apideploy'
        order '18'
        x '775'
        y '552'
        w '177'
        h '62'
        ownership 'flex'
        awsIcon 'apigateway'
        resources [
          'api-deploy',
          'lambda-cr'
        ]
      }
    }

    delivery_deploydev = platform 'Deploy to Development' {
      #off-request-path
      description 'no approval'
      technology '_build-deploy.yml'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/_build-deploy.yml '_build-deploy.yml'
      metadata {
        type 'Workflow job'
        tech '_build-deploy.yml'
        role 'Generate OpenAPI, cdk deploy --all, then Platform E2E.'
        facts [
          'pnpm openapi:generate runs first, so the specs ship with the deploy.',
          'cdk deploy --all --concurrency 4 --require-approval never.',
          'Platform E2E runs inside this job, so a failure blocks promotion.'
        ]
        sourceId 'deploydev'
        order '19'
        x '1003'
        y '227'
        w '179'
        h '66'
        ownership 'flex'
      }
    }

    delivery_e2edev = platform 'Module E2E · dev' {
      #off-request-path
      description 'non-gating'
      technology '_moduleE2E.yml'
      metadata {
        type 'Workflow'
        tech '_moduleE2E.yml'
        role 'Domain suites against the development stage.'
        facts [
          'A separate job that needs deployDev — and so does the staging deploy, so staging can start while these are still running.'
        ]
        sourceId 'e2edev'
        order '20'
        x '1243'
        y '227'
        w '177'
        h '66'
        ownership 'flex'
      }
    }

    delivery_gatestg = platform 'Approval gate · staging' {
      #off-request-path
      description 'GitHub environment'
      technology 'GitHub environments'
      metadata {
        type 'Environment protection'
        tech 'GitHub environments'
        role 'A human must approve before staging.'
        facts [
          'Configured on the GitHub environment the reusable deploy job names, not in the workflow file.',
          'The first of two independent approvals.'
        ]
        sourceId 'gatestg'
        order '21'
        x '1003'
        y '348'
        w '193'
        h '48'
        ownership 'flex'
      }
    }

    delivery_deploystg = platform 'Deploy to Staging' {
      #off-request-path
      description '+ Platform E2E'
      technology '_build-deploy.yml'
      metadata {
        type 'Workflow job'
        tech '_build-deploy.yml'
        role 'The same reusable job, with the staging stage and role.'
        facts [
          'Platform E2E runs here too, and a failure blocks production.'
        ]
        sourceId 'deploystg'
        order '22'
        x '1003'
        y '450'
        w '177'
        h '66'
        ownership 'flex'
      }
    }

    delivery_e2estg = platform 'Module E2E · staging' {
      #off-request-path
      description 'non-gating'
      technology '_moduleE2E.yml'
      metadata {
        type 'Workflow'
        tech '_moduleE2E.yml'
        role 'Domain suites against staging.'
        facts [
          'deployProd needs only deployStaging, so these suites run alongside the production gate rather than before it.'
        ]
        sourceId 'e2estg'
        order '23'
        x '1243'
        y '450'
        w '177'
        h '66'
        ownership 'flex'
      }
    }

    delivery_notifystg = platform 'Notify Slack · staging' {
      #off-request-path
      description 'non-gating'
      technology '_notify-deployment.yml'
      link https://github.com/govuk-once/flex/blob/main/.github/workflows/_notify-deployment.yml '_notify-deployment.yml'
      metadata {
        type 'Workflow'
        tech '_notify-deployment.yml'
        role 'Publishes the staging deployment notice.'
        facts [
          'Assumes the development role, because the release topic only exists in the development account.',
          'Both steps are continue-on-error — a failed notification must never fail the pipeline.'
        ]
        sourceId 'notifystg'
        order '24'
        x '1243'
        y '552'
        w '186'
        h '58'
        ownership 'flex'
      }
    }

    delivery_gateprod = platform 'Approval gate · prod' {
      #off-request-path
      description 'second separate approval'
      technology 'GitHub environments'
      metadata {
        type 'Environment protection'
        tech 'GitHub environments'
        role 'A second human approval before production.'
        facts [
          'Independent of the staging approval — approving one does not approve the other.'
        ]
        sourceId 'gateprod'
        order '25'
        x '1003'
        y '571'
