    delivery_alarms = platform 'CloudWatch alarms' {
      #off-request-path
      description '7 families'
      technology 'CloudWatch'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/constructs/alarms/actions.ts 'alarms/actions.ts'
      metadata {
        type 'Observability'
        tech 'CloudWatch'
        role 'Lambda, API Gateway, CloudFront, edge functions, WAF, Shield and the canary.'
        facts [
          'Every alarm routes to exactly one of two SNS topics, critical or warning — except the canary\'s {stage}-smoke-test-no-success alarm, which currently has no alarm action wired.',
          'Descriptions start with Critical: or Warning: and state the breached condition, so the Slack message alone usually picks the runbook.',
          'The four families created in us-east-1 can only reach Slack through the relay.'
        ]
        sourceId 'alarms'
        order '32'
        x '1496'
        y '253'
        w '177'
        h '70'
        ownership 'flex'
        awsIcon 'cloudwatch'
        resources [
          'alarms-lambda',
          'alarms-apigw',
          'alarms-cf',
          'alarms-cff',
          'alarms-waf',
          'alarms-shield',
          'xray'
        ]
      }
    }

    delivery_relay = platform 'Alarm relay' {
      #off-request-path
      description '2 topics + 2 inline fns'
      technology 'SNS → Lambda → SNS, one shared KMS key'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/global.ts 'stacks/global.ts'
      metadata {
        type 'Container'
        tech 'SNS → Lambda → SNS, one shared KMS key'
        role 'Republishes us-east-1 alarms onto the eu-west-2 topics — currently non-functional.'
        facts [
          'Lives in us-east-1: CloudWatch cannot target an SNS topic in another region, so edge alarms need this hop to reach the eu-west-2 topics.',
          'TopicArn: ${targetTopicArn} is interpolated unquoted into Code.fromInline, so the handler is a JavaScript syntax error and fails on every invocation. Every CloudFront, edge-function, CLOUDFRONT-scope WAF and Shield alarm therefore reaches nobody. The REGIONAL WAF alarms publish straight to the eu-west-2 topics and are unaffected.',
          'Passes through message and message attributes; truncates the subject to 100 characters.',
          '#buildRelay is called twice, once per severity, so there are two topics and two functions sharing one relay key.'
        ]
        sourceId 'relay'
        order '33'
        x '1719'
        y '253'
        w '187'
        h '70'
        ownership 'flex'
        awsIcon 'lambda'
        resources [
          'sns-relay',
          'lambda-relay',
          'kms-relay'
        ]
      }
    }

    delivery_topics = platform 'Alarm and release topics' {
