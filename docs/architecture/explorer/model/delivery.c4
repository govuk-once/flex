    delivery_canary = platform 'Smoke-test canary' {
      #off-request-path
      description 'EventBridge · every 5m'
      technology 'Lambda, no VPC'
      link https://github.com/govuk-once/flex/blob/main/platform/infra/flex/src/stacks/smoke-test.ts 'stacks/smoke-test.ts'
      link https://github.com/govuk-once/flex/blob/main/platform/smoke-test/src/credentials.ts 'credentials.ts'
      metadata {
        type 'Scheduled Lambda'
        tech 'Lambda, no VPC'
        role 'Synthetic canary exercising the whole public path.'
        facts [
          'Calls GET /app/udp/v1/users/me through the public URL, so CloudFront, the edge function, WAF, the certificate, the authorizer and the udp domain are all covered by one signal.',
          'Publishes Flex/SmokeTest.SmokeTestSuccess as 1 or 0 — but its alarm has no SNS action, so nothing is notified.',
          'Credentials differ by environment: a self-signed stub token in development, a real One Login sign-in with e-mail, password and TOTP in staging and production, and a Firebase App Check header everywhere except staging.',
          'Persistent stages only, production included — which makes it the second production caller of the public path.'
        ]
        sourceId 'canary'
        order '30'
        x '1496'
        y '116'
        w '184'
        h '70'
        ownership 'flex'
        awsIcon 'lambda'
        resources [
          'lambda-smoke',
          'events-rule',
          'alarms-smoke'
        ]
      }
    }

    delivery_firebase = external 'Firebase / GCP' {
      #off-request-path
      description 'App Check attestation'
      technology 'Workload identity federation'
      link https://github.com/govuk-once/flex/blob/main/platform/smoke-test/src/gcp.ts 'gcp.ts'
      metadata {
        type 'External system'
        tech 'Workload identity federation'
        role 'Mints the attestation token the canary attaches.'
        facts [
          'No stored key: an external account client exchanges a federated credential for a GCP token, then Firebase App Check mints the header.',
          'Used only by the canary — it is not on any user request path.'
        ]
        sourceId 'firebase'
        order '31'
        x '1719'
        y '116'
        w '177'
        h '70'
