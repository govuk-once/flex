views {
  view containers {
    title 'Containers'
    include containers_edge, containers_edge.**
    include containers_ingress, containers_ingress.**
    include containers_domains, containers_domains.**
    include containers_internal, containers_internal.**
    include containers_upstreams, containers_upstreams.**
    include containers_app, containers_app.**
