  components_cli -> components_tel 'third_party_* and service_gateway_* events' {
    technology 'Log line'
    link https://github.com/govuk-once/flex/blob/main/libs/service-gateway/src/client/adapter/rest.ts 'rest client'
    metadata {
      protocol 'Log line'
      auth 'None'
      carries 'event name plus a small details object'
      order '20'
