    metadata {
      protocol 'Module import at synth'
      auth 'None — synth time'
      carries 'The route table, filtered by the environments arrays'
      facts [
        'The CDK app imports the same <code>domain.config.ts</code> the Lambda will import, so no route list is written twice.'
      ]
      order '0'
      edgeStyle 'dash'
