  components_integ -> components_look 'SigV4 · ANY /gateways/{name}/{proxy+}' {
    technology 'HTTPS over the private API'
    link https://github.com/govuk-once/flex/blob/main/libs/sdk/src/fetch/sigv4.ts 'signed fetcher'
    link https://github.com/govuk-once/flex/blob/main/libs/service-gateway/src/handler/index.ts 'prefix stripping'
    metadata {
      protocol 'HTTPS over the private API'
      auth 'SigV4 with the route Lambda\'s own execution role'
      carries 'The integration\'s base path plus any wildcard suffix'
      facts [
        'Signed with the calling Lambda\'s own credentials, not an assumed role — the assumed role appears one hop later, between the gateway and its upstream.',
        'Single attempt: nothing on this path sets <code>retryAttempts</code>.'
      ]
      order '12'
