{
  "name": "@flex/architecture-docs",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "facts": "tsx scripts/architectureFacts.ts",
    "build": "pnpm facts && tsx scripts/buildArchitectureExplorer.ts",
    "check": "tsx scripts/checkArchitectureExplorer.ts",
    "serve": "pnpm build && tsx scripts/serveArchitectureDocs.ts",
    "tsc": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest --passWithNoTests"
  },
  "devDependencies": {
    "@flex/config": "workspace:*",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "likec4": "1.59.2",
    "playwright": "1.61.0",
    "prettier": "3.8.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
