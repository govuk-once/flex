{
  "name": "flex",
  "type": "module",
  "scripts": {
    "dev": "flex",
    "deploy": "pnpm openapi:generate && pnpm --filter @platform/flex run deploy",
    "checkov": "nx affected --target=checkov",
    "tsc": "nx affected --target=tsc",
    "lint": "nx affected --target=lint",
    "lint:report": "eslint domains libs platform tests/e2e --format json --output-file eslint-report.json",
    "test": "nx affected --target=test --run",
    "test:coverage": "nx run-many --target=test:coverage --run",
    "test:e2e": "nx run-many --target=test:e2e --run",
    "jwt": "tsx scripts/generateToken.ts",
    "jwt:playground": "tsx scripts/generatePlaygroundToken.ts",
    "dastSetup": "tsx scripts/dastSetup.ts",
    "s3:enforce-tls": "tsx scripts/enforceS3SecureTransport.ts",
    "semantic:release": "semantic-release",
    "openapi:generate": "tsx scripts/generateOpenapi.ts",
    "validate:integrations": "pnpm --filter @platform/flex run validate:integrations"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@flex/cli": "workspace:*",
    "@flex/config": "workspace:*",
    "@flex/testing": "workspace:*",
    "@semantic-release/exec": "7.1.0",
    "conventional-changelog-conventionalcommits": "10.2.1",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "nx": "23.1.0",
    "semantic-release": "25.0.8",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "zod": "4.4.3",
    "zod-openapi": "6.0.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
